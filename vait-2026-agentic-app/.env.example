# Copy to .env and fill in ONE provider. .env is git-ignored: never commit it.
# Switching provider = change PROVIDER and restart.

# Which provider every section uses (except 1.1, which always calls the Claude API):
PROVIDER=anthropic  # anthropic | bedrock | openai

# ── Claude API (Anthropic) ───────────────────────────────────────────────
# Also needed for section 1.1 Raw model call.
ANTHROPIC_API_KEY=sk-ant-...

# ── Amazon Bedrock ───────────────────────────────────────────────────────
# AWS_PROFILE=your-profile
# AWS_REGION=us-west-2
# Set to false if your role allows InvokeModel but not InvokeModelWithResponseStream.
# BEDROCK_STREAMING=false

# ── OpenAI ───────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# Optional: override the provider's default model
# MODEL_ID=
